# ==========================================================================
# Calma Global — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com suas credenciais.
# O site FUNCIONA SEM estas variáveis (usa dados de exemplo locais),
# mas para persistir conteúdo no banco você precisa configurar o Supabase.
# ==========================================================================

# URL pública do site (usada em SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (opcional em desenvolvimento) ---
# Encontre em: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Analytics (opcional) ---
# Google Analytics 4 measurement ID (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Formulário de contato (opcional, mas recomendado) ---
# Envio real das mensagens do formulário sem precisar de backend.
# 1. Crie uma conta gratuita em https://web3forms.com (só com seu e-mail)
# 2. Copie a "Access Key" e cole abaixo
# Sem esta chave, o formulário apenas simula o envio.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Captura de lead do Guia Definitivo (MailerLite) ---
# SERVER-SIDE (sem NEXT_PUBLIC): a chave nunca é exposta no navegador.
# MAILERLITE_API_KEY: em MailerLite > Integrations > API
# MAILERLITE_GROUP_ID: (opcional) id do grupo que recebe os leads do guia
# SITE_URL: usada no e-mail de entrega (ex.: https://calmglobal.vercel.app)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
SITE_URL=
