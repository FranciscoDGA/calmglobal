# ==========================================================================
# Calma Global — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com suas credenciais.
# O site FUNCIONA SEM estas variáveis (usa dados de exemplo locais),
# mas para persistir conteúdo no banco você precisa configurar o Supabase.
# ==========================================================================

# URL pública do site (usada em SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (opcional em desenvolvimento) ---
# Encontre em: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Analytics (opcional) ---
# Google Analytics 4 measurement ID (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
